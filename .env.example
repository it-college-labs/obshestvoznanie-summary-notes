APP_DOMAIN=neuroarchive.local
BASE_URL=http://neuroarchive.local

# Generate with: go run scripts/generate-hash.go
ADMIN_PASSWORD_HASH=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

DATABASE_URL=postgres://neuro:neuro@db:5432/neuroarchive?sslmode=disable
UPLOAD_DIR=/app/data/uploads

# Set to false for local HTTP (.local), true for HTTPS/production
SECURE_COOKIE=false
